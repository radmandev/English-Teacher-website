# SQLite for local development. For production switch the provider in prisma/schema.prisma
# to "postgresql" and use e.g. postgresql://user:pass@host:5432/fahm
DATABASE_URL="file:./dev.db"

# Public site URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: creates/updates an administrator account when running `npm run db:seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
