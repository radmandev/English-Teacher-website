# MySQL / MariaDB. On Hostinger use host 127.0.0.1 (not localhost) and the prefixed names from hPanel,
# e.g. mysql://u123456789_fahm:PASSWORD@127.0.0.1:3306/u123456789_fahm
DATABASE_URL="mysql://root@127.0.0.1:3306/fahm"

# Public site URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: creates/updates an administrator account when running `npm run db:seed`.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
